# Anthropic API key. Server-side only — read inside the route handlers and
# never exposed to the browser. Required; without it both routes return CONFIG.
ANTHROPIC_API_KEY=sk-ant-...

# Origin the QR handoff link points at. Set to your LAN address for a local
# demo, because a QR encoding "localhost" resolves to the scanning phone.
# Leave unset when deployed.
NEXT_PUBLIC_HANDOFF_ORIGIN=http://192.168.0.10:3000
